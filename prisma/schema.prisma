generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

// ─── AUTH (Better Auth) ───────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      Session[]
  accounts      Account[]
  ownedProperties Property[]       @relation("PropertyOwner")
  memberships   PropertyMember[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── MÉTIER ───────────────────────────────────────────────────────────────────

model Property {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  slug        String   @unique
  address     String
  type        String   @default("apartment_building")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User             @relation("PropertyOwner", fields: [ownerId], references: [id])
  members     PropertyMember[]
  units       Unit[]
}

// Gestion des droits par bien — property-based permissions
// Un utilisateur voit un bien s'il en est le owner OU s'il est dans PropertyMember avec acceptedAt non null
// Rôles : owner (implicite via Property.ownerId) | admin | editor | viewer
model PropertyMember {
  id         String    @id @default(cuid())
  propertyId String
  userId     String
  role       String    @default("viewer") // admin | editor | viewer
  invitedAt  DateTime  @default(now())
  acceptedAt DateTime?                     // null = invitation en attente

  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([propertyId, userId])
}

model Unit {
  id             String    @id @default(cuid())
  propertyId     String
  name           String
  slug           String    @unique
  floor          Int?
  surface        Float?
  floorPlanUrl   String?   // URL Supabase Storage du plan uploadé
  floorPlanZones Json?     // zones détectées par Claude Vision [{ id, name, coordinates }]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  property       Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rooms          Room[]
  tenants        Tenant[]
  documents      Document[]
  workOrders     WorkOrder[]
}

model Room {
  id              String     @id @default(cuid())
  unitId          String
  name            String
  zoneCoordinates Json?      // { x, y, width, height } en pourcentage du plan
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  unit            Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  documents       Document[]
  workOrders      WorkOrder[]
}

model Tenant {
  id          String     @id @default(cuid())
  unitId      String
  fullName    String
  email       String?
  phone       String?
  leaseStart  DateTime
  leaseEnd    DateTime?
  monthlyRent Float
  deposit     Float?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  unit        Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  documents   Document[]
}

model Document {
  id         String    @id @default(cuid())
  unitId     String?
  roomId     String?
  tenantId   String?
  name       String
  fileUrl    String    // URL Supabase Storage
  fileType   String    // MIME type
  fileSize   Int?      // en octets
  type       String    @default("other") // lease | inventory | invoice | insurance | diagnostic | other
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  unit       Unit?     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  room       Room?     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tenant     Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model WorkOrder {
  id               String    @id @default(cuid())
  unitId           String?
  roomId           String?
  description      String
  contractor       String?
  amount           Float?
  interventionDate DateTime?
  status           String    @default("pending") // pending | in_progress | completed
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  unit             Unit?     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  room             Room?     @relation(fields: [roomId], references: [id], onDelete: Cascade)
}
